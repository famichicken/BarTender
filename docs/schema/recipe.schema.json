{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bartender.app/schema/recipe.schema.json",
  "title": "BarTender Recipe",
  "description": "G2向けカクテルアプリの内蔵レシピ1件。LocalizedTextは en 必須・ja 推奨。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "groups", "glass", "method", "ingredients", "steps", "source"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$",
      "description": "一意のスラッグ。例: gin_tonic, whisky_sour"
    },
    "name": { "$ref": "#/$defs/localizedText" },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/baseGroup" },
      "description": "ベース/主要グループ（複数可）。例: whisky_sour は ['whisky','sour']"
    },
    "flavors": {
      "type": "array",
      "items": { "$ref": "#/$defs/flavorTag" },
      "description": "味/感覚タグ。さわやか・マイルド等"
    },
    "strength": { "$ref": "#/$defs/strength" },
    "modeAdjustable": {
      "type": "boolean",
      "description": "軽め/標準/濃いめ の3モードに対応するか"
    },
    "glass": { "$ref": "#/$defs/glass" },
    "method": { "$ref": "#/$defs/method" },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/recipeIngredient" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/localizedText" },
      "description": "正式版の手順。1ステップ=1動作。G2表示を意識し各 en は簡潔に。"
    },
    "casual": {
      "type": "object",
      "additionalProperties": false,
      "description": "ゆる版（初心者向け）表現。任意だが modeAdjustable=true のレシピは推奨。",
      "properties": {
        "name": { "$ref": "#/$defs/localizedText", "description": "「ジンリッキー風」等の'〜風'名称" },
        "visualSteps": {
          "type": "array",
          "items": { "$ref": "#/$defs/localizedText" },
          "description": "「ジンを赤線まで」「炭酸を青線まで」等の視覚的手順（液面ガイド色規約: 赤=ベース/黄=酸味/青=割材/灰=氷）"
        },
        "maxIngredients": { "type": "integer", "minimum": 1, "maximum": 6 },
        "substitutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ingredientId", "alternatives"],
            "properties": {
              "ingredientId": { "type": "string" },
              "alternatives": { "type": "array", "items": { "type": "string" }, "description": "代替材料の ingredientId" },
              "note": { "$ref": "#/$defs/localizedText" }
            }
          }
        }
      }
    },
    "estimatedAbv": {
      "type": "number",
      "minimum": 0,
      "maximum": 96,
      "description": "推定アルコール度数(%)。安全注意表示に使用。ノンアルは0。"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "おすすめ分類: aperitif/digestif/party/relax/nightcap/spring/summer/autumn/winter/easy/intermediate/classic/signature 等"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "description": "Codex生成の画像アセット参照（相対パス）。スタイルは CODEX_RECIPE_BRIEF.md 参照。",
      "properties": {
        "hero": { "type": "string", "description": "スマホ/LP用のメイン画像。例: assets/recipes/gin_tonic/hero.webp" },
        "thumb": { "type": "string", "description": "一覧用サムネ（任意）" },
        "glassSilhouette": { "type": "string", "description": "G2タイル向けの簡素なグラスシルエット（任意, 単色想定）" }
      }
    },
    "source": { "type": "string", "enum": ["builtin", "user"] }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "ja": { "type": "string" }
      }
    },
    "baseGroup": {
      "type": "string",
      "enum": ["gin", "rum", "whisky", "vodka", "sour", "beer", "non_alcohol", "tequila", "brandy", "wine_sparkling", "liqueur"]
    },
    "flavorTag": {
      "type": "string",
      "enum": ["refreshing", "mild", "sweet", "dry", "bitter", "fruity", "sour_taste", "rich", "herbal", "creamy"]
    },
    "strength": { "type": "string", "enum": ["light", "medium", "strong"] },
    "glass": {
      "type": "string",
      "description": "代表的なグラス種別。自由文字列可だが既定語彙を優先。",
      "examples": ["rocks", "highball", "cocktail", "collins", "shot", "wine", "beer_mug", "copper_mug"]
    },
    "method": { "type": "string", "enum": ["build", "shake", "stir", "blend"] },
    "recipeIngredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingredientId"],
      "properties": {
        "ingredientId": { "type": "string", "description": "ingredients.json の id を参照" },
        "amount": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "examples": ["ml", "dash", "tsp", "piece", "leaf", "to_top"] },
        "optional": { "type": "boolean", "description": "任意材料（判定除外）" },
        "garnish": { "type": "boolean", "description": "ガーニッシュ（判定除外）" }
      }
    }
  }
}
